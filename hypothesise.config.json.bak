{
  "mcpServers": {
    "fs": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem",
               "/Volumes/Seagate/uris"]
    },
    "db": {
      "command": "npx",
      "args": ["-y", "mcp-server-sqlite-npx",
               "/Volumes/Seagate/uris/backend/uris.db"]
    }
  },
  "hypothesise": {
    "mode": "observe",
    "failMode": "open",
    "budgetMs": 50,
    "apiUrl": "http://127.0.0.1:8080",
    "agentId": "copilot-uris"
  }
}
