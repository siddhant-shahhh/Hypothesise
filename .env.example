# --- Weaver / AI_Layer ---
WEAVER_DB_URL=sqlite:///./data/weaver.db
WEAVER_LOG_LEVEL=INFO

# Enforcement
WEAVER_MODE=observe          # observe | enforce
WEAVER_FAIL_MODE=open        # open | closed   (open = allow on engine error)
WEAVER_DECISION_BUDGET_MS=50

# Risk model
WEAVER_ALPHA=0.35            # reinforcement rate
WEAVER_LAMBDA=0.02           # decay rate per hour
WEAVER_TRUST_WARM=0.70
WEAVER_TRUST_HOT=0.30

# API
WEAVER_API_HOST=127.0.0.1
WEAVER_API_PORT=8080
WEAVER_API_KEY=changeme
