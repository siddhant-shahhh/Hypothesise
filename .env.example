# --- Hypothesise / AI_Layer ---
HYPOTHESISE_DB_URL=sqlite:///./data/hypothesise.db
HYPOTHESISE_LOG_LEVEL=INFO

# Enforcement
HYPOTHESISE_MODE=observe          # observe | enforce
HYPOTHESISE_FAIL_MODE=open        # open | closed   (open = allow on engine error)
HYPOTHESISE_DECISION_BUDGET_MS=50

# Risk model
HYPOTHESISE_ALPHA=0.35            # reinforcement rate
HYPOTHESISE_LAMBDA=0.02           # decay rate per hour
HYPOTHESISE_TRUST_WARM=0.70
HYPOTHESISE_TRUST_HOT=0.30

# API
HYPOTHESISE_API_HOST=127.0.0.1
HYPOTHESISE_API_PORT=8080
HYPOTHESISE_API_KEY=changeme
